# 部署现场：复制成 .deploy.env 再填（.deploy.env 已被 .gitignore 挡住，不会进提交）。
#
#   cp .deploy.env.example .deploy.env
#   $EDITOR .deploy.env
#   scripts/deploy-remote.sh
#
# 这个文件会被 scripts/deploy-remote.sh 用 `.` 读进 shell，所以只写 KEY=VALUE，
# 别放命令 —— 它和 .env 一样，是给脚本读的配置，不是可执行脚本。

# 目标机，ssh 能直接连上的形式（建议先配好公钥登录，脚本不处理密码）
REMOTE=user@example.com

# SSH 端口（默认 22）
SSH_PORT=22

# 目标机上插件目录的绝对路径（profile 的 link: 指着它）
REMOTE_DIR=/home/user/dsh-qq-bridge

# 远端 systemd user 服务名
SERVICE=dsh-web
