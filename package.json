{
  "name": "@qqbot/dsh-plugin-qq",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "Bidirectional QQ (OneBot v11) bridge: QQ messages drive Harness agents, and any agent can send QQ messages, images and stickers back into a chat.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyinstar/dsh-qq-bridge.git"
  },
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test test/",
    "test:coverage": "node --test --experimental-test-coverage test/",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./image.js": "./image.js",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "files": [
    "index.js",
    "client.js",
    "settings.js",
    "filestore.js",
    "util.js",
    "chatter.js",
    "speaking-rules.js",
    "backlog.js",
    "mute.js",
    "editor.js",
    "owner-settings.js",
    "commands.js",
    "mode.js",
    "weather.js",
    "balance.js",
    "music.js",
    "tts.js",
    "fun.js",
    "chat-state.js",
    "memory.js",
    "memory-select.js",
    "config.js",
    "tools.js",
    "onebot.js",
    "media.js",
    "gif.js",
    "storyboard.js",
    "sticker-frames.js",
    "image.js",
    "send.js",
    "sticker.js",
    "mention.js",
    "napcat.js",
    "desktop.js",
    "perceptual.js",
    "persona.js",
    "style.js",
    "prompt.js",
    "speech-policy.js",
    "modalities.js",
    "voice.js",
    "forward.js",
    "links.js",
    "interactions.js",
    "recall.js",
    "reminders.js",
    "cognition.js",
    "docfile.js",
    "ops.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    ".dsh/skills/*/SKILL.md",
    "README.md",
    "docs/*.md",
    "docs/images/*",
    "docs/agents/*.md",
    "scripts/*",
    "test/*.mjs",
    "deploy/*",
    "deploy/SEMANTICS.md",
    "batch.js",
    "reminder-runtime.js",
    "routes.js",
    "key-rotation.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
