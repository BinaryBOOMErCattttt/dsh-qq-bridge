{
  "name": "@qqbot/dsh-plugin-qq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bidirectional QQ (OneBot v11) bridge: QQ messages drive Harness agents, any agent can send QQ messages, images and stickers, and JM comics can be downloaded as PDFs straight into a chat.",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./jm.js": "./jm.js",
    "./image.js": "./image.js",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "settings.js",
    "filestore.js",
    "util.js",
    "chatter.js",
    "memory.js",
    "config.js",
    "tools.js",
    "onebot.js",
    "media.js",
    "image.js",
    "jm.js",
    "perceptual.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    ".dsh/skills/*/SKILL.md",
    "README.md",
    "scripts/*",
    "test/*.mjs",
    "deploy/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
